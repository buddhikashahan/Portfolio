# --- Database -------------------------------------------------------------
# SQLite by default so the project runs with zero external services.
# To move to Postgres: change `provider` in prisma/schema.prisma to "postgresql",
# swap the driver adapter in src/lib/prisma.ts, and point DATABASE_URL here.
DATABASE_URL="file:./prisma/dev.db"

# --- Auth -----------------------------------------------------------------
# Signing key for the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Seeded dashboard credentials (used by `npm run db:seed`).
ADMIN_EMAIL="buddhikashahan2@gmail.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Buddhika Shahan"

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://buddhika.dev"
