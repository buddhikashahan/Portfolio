# --- Database -------------------------------------------------------------
# Postgres connection string.
DATABASE_URL="postgres://user:password@host:5432/database"

# --- Auth -----------------------------------------------------------------
# Signing key for the admin session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Encrypts Server Action reference IDs. Must stay the same across every build
# and every running instance — Next.js otherwise generates a new one per
# build, and a page from an older build can no longer call its actions.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# Dashboard credentials (used by `npm run db:seed` locally, `npm run
# db:seed-admin` in production).
ADMIN_EMAIL="buddhikashahan2@gmail.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Buddhika Shahan"

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://buddhika.dev"
