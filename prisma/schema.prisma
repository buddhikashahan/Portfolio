// Prisma schema for the buddhika.dev portfolio.
// Datasource URL lives in prisma.config.ts (Prisma 7 config convention).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Dashboard operator. Seeded from ADMIN_EMAIL / ADMIN_PASSWORD.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Singleton row (id = "singleton") holding everything shown in the site chrome,
/// the hero, and the about page's profile card.
model Profile {
  id       String @id @default("singleton")
  fullName String
  headline String
  tagline  String
  bio      String

  /// JSON array of strings driving the animated hero typewriter.
  taglines String @default("[]")

  avatarUrl String?
  resumeUrl String?

  email     String
  location  String?
  /// Shown next to the location, e.g. "GMT+5:30". Remote clients plan around it.
  timezone  String?
  languages String?

  githubUrl   String?
  linkedinUrl String?
  whatsappUrl String?
  twitterUrl  String?
  available   Boolean @default(true)

  yearsExperience Int @default(0)
  projectsCount   Int @default(0)
  clientsCount    Int @default(0)

  updatedAt DateTime @updatedAt
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String
  icon        String  @default("Code")
  order       Int     @default(0)
  published   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model SkillCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  icon        String  @default("Layers")
  order       Int     @default(0)
  skills      Skill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Skill {
  id   String @id @default(cuid())
  name String
  /// Simple Icons slug (e.g. "react", "postgresql") used to render the brand
  /// mark. Unrecognised or empty values fall back to a monogram tile.
  icon String?
  /// Optional one-line note, e.g. "4 years in production".
  note String?
  order Int   @default(0)

  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, order])
}

model Project {
  id         String  @id @default(cuid())
  slug       String  @unique
  title      String
  summary    String
  /// Markdown case study shown on /projects/[slug].
  content    String  @default("")
  coverImage String?
  category   String  @default("Full-Stack")
  /// Comma-separated tag list.
  tags       String  @default("")
  /// JSON array of `{ label, url }`, e.g. a frontend repo, a backend repo and
  /// a published npm package all belonging to the same project.
  repos      String  @default("[]")
  /// JSON array of `{ label, url }`, e.g. a production site, a staging
  /// environment and a demo video all belonging to the same project.
  liveUrls   String  @default("[]")
  featured   Boolean @default(false)
  published  Boolean @default(true)
  order      Int     @default(0)
  date       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
  @@index([category])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  /// Markdown body rendered on /blog/[slug].
  content     String    @default("")
  coverImage  String?
  tags        String    @default("")
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, publishedAt])
}

model Experience {
  id          String    @id @default(cuid())
  role        String
  company     String
  location    String?
  description String
  tags        String    @default("")
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  order       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Education {
  id          String  @id @default(cuid())
  degree      String
  institution String
  description String?
  startYear   String
  endYear     String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Certificate {
  id       String  @id @default(cuid())
  title    String
  issuer   String
  year     String
  url      String?
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String?
  company   String?
  quote     String
  avatarUrl String?
  rating    Int     @default(5)
  published Boolean @default(true)
  order     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// Contact form submissions, triaged from the dashboard inbox.
model Message {
  id          String  @id @default(cuid())
  name        String
  email       String
  company     String?
  projectType String?
  message     String
  read        Boolean @default(false)
  archived    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([archived, createdAt])
}
